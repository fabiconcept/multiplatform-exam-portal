{
  "name": "@exam-portal/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Fabi CBT Desktop Application",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron dist/main/main.js",
    "dev:renderer": "vite --config vite.config.ts",
    "build": "tsc -p tsconfig.main.json && vite build --config vite.config.ts && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "clean": "rm -rf dist release"
  },
  "dependencies": {
    "@exam-portal/types": "*",
    "@exam-portal/utils": "*",
    "@exam-portal/api-client": "*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.23.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.fabicbt.desktop",
    "productName": "Fabi CBT",
    "directories": { "output": "release" },
    "files": ["dist/**/*"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
